# Copy this file to .env and fill it in. NEVER commit .env.

ANTHROPIC_API_KEY=sk-ant-...

# paper = fake money (default). live = real orders.
MODE=paper

# ---- live trading only ----
# Both must be set for real orders. Use a NEW wallet holding only your test money.
LIVE_TRADING_CONFIRMED=false
POLYMARKET_PRIVATE_KEY=
POLYMARKET_WALLET=

# ---- optional overrides (defaults shown) ----
# STARTING_BANKROLL_USD=20
# MAX_STAKE_USD=2
# DAILY_AI_BUDGET_USD=1.00
# MAX_DAYS_TO_END=14
# EXCLUDED_TOPICS=crypto,sports
